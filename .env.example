# Скопируйте в .env и заполните. .env в git не попадает.

# PostgreSQL: основная база и отдельная база для тестов
DATABASE_URL=postgres://postgres:ПАРОЛЬ@localhost:5432/servicedesk
TEST_DATABASE_URL=postgres://postgres:ПАРОЛЬ@localhost:5432/servicedesk_test

# Порт API. Клиент в режиме разработки работает на 5179 и проксирует /api сюда.
API_PORT=8431
# Адрес, по которому сотрудники открывают сервис (ссылки в Telegram/Max)
PUBLIC_URL=http://localhost:5179
# С каких адресов разрешены изменяющие запросы (через запятую)
ALLOWED_ORIGINS=http://localhost:5179,http://127.0.0.1:5179
# true — только если сервис открыт по HTTPS
COOKIE_SECURE=false
APP_NAME="ASOFT Сервис"
APP_TIMEZONE=Asia/Yekaterinburg

# Пароль демо-сотрудников, которых создаёт npm run db:seed (от 8 символов)
SEED_PASSWORD=

# Уведомления в мессенджеры. Пусто — канал выключен, остальное работает.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api.max.ru

# Файлы вложений (папка вне git) и лимит размера одного файла
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
